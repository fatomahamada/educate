<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Student Management System</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('../components/navbar.ejs') %>
    <main class="main-content">
        <div class="page-container">
            
            <div class="login-section">
                <div class="login-card">
                    <h1 class="login-title">Login</h1>
                    
                    <form action="/register" method="POST">
                        <div class="input-group">
                            <label for="username">User Name</label>
                            <input type="text" id="username" name="Name" placeholder="Enter your name" required>
                        </div>
                        
                        <div class="input-group">
                            <label for="password">userName</label>
                            <input type="text" id="userName" name="userName" placeholder="Enter your userName" required>
                        </div>
                        
                        <div class="input-group">
                            <label for="username">age</label>
                            <input type="text" id="age" name="age" placeholder="Enter your age" required>
                        </div>
                        
                        <div class="input-group">
                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" placeholder="••••••••" required>
                        </div>
                        
                        <!-- <div class="input-group">
                            <label for="password">confirmpassword</label>
                            <input type="password" id="password" name="password" placeholder="Enter your name password" required>
                        </div> -->
                        
                        <div class="input-group">
                            <label for="password">phone</label>
                            <input type="phone" id="phone" name="phone" placeholder="phone" required>
                        </div>
                        
                        <div class="input-group">
                            <label for="email">email</label>
                            <input type="email" id="email" name="email" placeholder="Enter your email" required>
                        </div>
                        
                        <div class="input-group">
                            <label for="gender">gender</label>
                            <input type="gender" id="gender" name="gender" placeholder="gender" required>
                        </div>
                        
                        <button type="submit" class="login-btn">Register</button>
                    </form>

                    <div class="register-link">
                        YOU have an account? <a href="/login.html">Login</a>
                    </div>
                </div>
            </div>

            <div class="image-section">
                <div class="image-overlay">
                    <h2>Student Portal</h2>
                    <p>Start your journey and manage your education efficiently.</p>
                </div>
            </div>

        </div>
    </main>

</body>
</html>