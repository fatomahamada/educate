<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>show</title>
    <link rel="stylesheet" href="/mystyle.css">
</head>
<body>

    <%- include('./components/navbar.ejs') %>


    <div class="container">
        <h1>more details about <%= user.firstName %> <%= user.lastName %></h1>

        <div class="details-card">
            <div class="detail-item">
                <span class="label">ID </span>
                <span class="value"><%= user._id %></span>
            </div>
            <div class="detail-item">
                <span class="label">Full Name </span>
                <span class="value"><%= user.firstName %> <%= user.lastName %></span>
            </div>
            <div class="detail-item">
                <span class="label">Age</span>
                <span class="value"><%= user.age %></span>
            </div>
            <div class="detail-item">
                <span class="label">City</span>
                <span class="value"><%= user.city %></span>
            </div>
            <div class="detail-item">
                <span class="label">Level :</span>
                <span class="value"><%= user.level %></span>
            </div>
            <div class="detail-item">
                <span class="label">Phone Number :</span>
                <span class="value"><%= user.phone %></span>
            </div>
            <div class="detail-item">
                <span class="label">email address:</span>
                <span class="value"><%= user.email %></span>
            </div>
            <div class="detail-item">
                <span class="label">first language :</span>
                <span class="value"><%= user.firstLanguage %></span>
            </div>
            <div class="detail-item">
                <span class="label">second language :</span>
                <span class="value"><%= user.secondLanguage %></span>
            </div>
            <div class="detail-item">
                <span class="label">gender :</span>
                <span class="value"><%= user.gender %></span>
            </div>
            <div class="detail-item">
                <span class="label">universe :</span>
                <span class="value"><%= user.univarse %></span>
            </div>

            <div class="detail-item">
                <span class="label">created At :</span>
                <span class="value"><%= moment(user.createdAt).fromNow() %></span>
            </div>

            <div class="detail-item">
                <span class="label">last Updated :</span>
                <span class="value"><%= moment(user.updatedAt).fromNow() %></span>
            </div>
            
            
        </div>
    </div>
<%- include('./components/footer.ejs') %>
</body>
</html>