<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home</title>
    <link rel="stylesheet" href="mystyle.css">
</head>
<body>

    <%- include('./components/navbar.ejs') %>


    <div class="container">
        <h1>home page </h1>

        <!-- <a href="create.ejs" class="btn">create</a> -->

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Full name</th>
                    <th>Age</th>
                    <th>City</th>
                    <th>Level</th>
                    <th>phone</th>
                    <th>icon</th>
                </tr>
            </thead>
            <tbody>
                <% arr.forEach((item,index) => { %>
                    <tr>
                    <td><%= index + 1 %></td>
                    <td><%= item.fullName %></td>
                    <td><%= item.age %></td>
                    <td><%= item.city %></td>
                    <td><%= item.level %></td>
                    <td><%= item.phone %></td>
                    <td> <a class="btn" href ="/show.html/<%= item.fullName %>">show</a></td>
                </tr>
                <% }) %>
                
            </tbody>
        </table>
    </div>
<%- include('./components/footer.ejs') %>
</body>
</html>